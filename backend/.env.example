# API local para LuzFlorencia
PORT=8000
DATABASE_URL=postgresql://postgres:CAMBIE_ESTA_CLAVE@localhost:5432/luzflorencia
APP_BASE_URL=http://localhost:8000

# Configuración SMTP para enviar recuperación de contraseña por correo
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cuenta@example.com
SMTP_PASSWORD=contraseña_o_clave_de_aplicacion
SMTP_FROM=LuzFlorencia <cuenta@example.com>
